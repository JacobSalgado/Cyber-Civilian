  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "All Abilities Drains the Resource Meter:\n\n\n- Launches Player Forward
    in the direction of their movement\n\n\n- Allows Player to pass through projectiles
    and level geometry\n\n \n- Block incoming attacks within 90 degrees of your Field
    of view\n\n\n- Absorbs incoming projectiles and applies a damage boost to player's
    attacks, Too many absorbed will cause the player to take damage\n\n\n- Pushes
    enemy backwards"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: c12f3c067d5a6c94a83a89ab5092407e, type: 2}
